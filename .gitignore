# Godot 4+ specific ignores
.godot/
/android/

# Python tooling cache (tools/*.py)
__pycache__/
*.pyc

# Stray npm folder (nothing here uses npm)
node_modules/

# Local dev tools venv (see scripts/setup-dev.sh)
.devtools/

# Parked characters (feyke/katalyst/lenbondosen/wayna) — moved out to keep this repo Khalid-only.
# Kept locally for backup / migration to a separate repo; Godot skips it via playground/.gdignore.
playground/

# Per-machine compile-time log written by every build (see mygamedev.csproj)
build_times.log
